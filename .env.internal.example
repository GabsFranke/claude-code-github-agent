# Secrets for internal service-to-service calls.
#
# This file is loaded ONLY by the `scheduler` and `mcp_proxy` services. It is
# deliberately separate from .env because `sandbox_worker` loads .env in full,
# and the agent running there has Bash and runs on attacker-authored issue and
# PR text. Anything in .env is therefore readable by the very actor these
# secrets exist to stop.
#
# Copy to .env.internal and fill in. The file is optional: without it,
# POST /schedule/one-shot returns 503 and agent-initiated one-shot scheduling
# is simply disabled. Cron schedules from workflows.yaml are unaffected.

# Shared secret for POST /schedule/one-shot.
#   openssl rand -hex 32
SCHEDULER_INTERNAL_TOKEN=
